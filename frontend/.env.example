# Todas as variáveis são OPCIONAIS em desenvolvimento local:
# o Vite faz proxy de /api para http://localhost:8000 automaticamente.

# URL do backend quando NÃO estiver usando o proxy (ex.: backend em outra máquina).
# Obs.: ao acessar via IP de rede local (192.168.x.x), o app usa https://<ip>:8000 direto
# e IGNORA esta variável (necessário para testar no celular).
# VITE_API_URL=http://localhost:8000

# URL do backend ao expor o app via Cloudflare Tunnel (a URL muda a cada sessão do túnel).
# VITE_CLOUDFLARE_BACKEND=https://seu-tunel.trycloudflare.com

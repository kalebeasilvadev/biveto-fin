# Database
# SQLite para desenvolvimento (padrão - sem necessidade de Docker):
DATABASE_URL=sqlite+aiosqlite:///./financeiro.db

# PostgreSQL local via Docker (make docker-up):
# DATABASE_URL=postgresql+asyncpg://biveto:biveto_secret@localhost:5433/biveto_db

# JWT
SECRET_KEY=sua-chave-secreta-aqui-mude-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
DEBUG=true
ENVIRONMENT=development

# Document Processing
MAX_UPLOAD_SIZE_MB=10

# LLM/Vision API para OCR inteligente
# Providers suportados: google, openai, anthropic
VISION_PROVIDER=google
VISION_MODEL=gemini-2.0-flash

# Google Gemini (GRÁTIS - recomendado para dev)
# Obtenha sua chave em: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenAI (opcional)
# OPENAI_API_KEY=

# Anthropic Claude (opcional)
# ANTHROPIC_API_KEY=

# Mistral AI (melhor custo-benefício para OCR)
# Obtenha sua chave em: https://console.mistral.ai/
# MISTRAL_API_KEY=
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# MISTRAL_LLM_MODEL=mistral-large-latest

# SMTP Configuration (para envio de convites)
# Hostinger usa porta 465 com SSL
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=noreply@biveto.com
SMTP_PASSWORD=
SMTP_FROM_NAME=Biveto
SMTP_FROM_EMAIL=noreply@biveto.com

# Frontend URL (para links nos emails)
FRONTEND_URL=https://biveto.com

# Database
# SQLite para desenvolvimento (padrão - sem necessidade de Docker):
DATABASE_URL=sqlite+aiosqlite:///./financeiro.db

# PostgreSQL para produção (requer Docker ou instalação local):
# DATABASE_URL=postgresql+asyncpg://financeiro:financeiro_secret@localhost:5432/financeiro_db

# JWT
SECRET_KEY=sua-chave-secreta-aqui-mude-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
DEBUG=true
ENVIRONMENT=development

# Document Processing
MAX_UPLOAD_SIZE_MB=10

# LLM/Vision API para OCR inteligente
# Providers suportados: google, openai, anthropic
VISION_PROVIDER=google
VISION_MODEL=gemini-2.0-flash

# Google Gemini (GRÁTIS - recomendado para dev)
# Obtenha sua chave em: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenAI (opcional)
# OPENAI_API_KEY=

# Anthropic Claude (opcional)
# ANTHROPIC_API_KEY=
